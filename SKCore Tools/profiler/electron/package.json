{
  "name": "omniprofiler-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OmniProfiler — Unity için sıfır-overhead derinlemesine profilme panosu (Electron kabuğu)",
  "main": "electron/main.js",
  "author": "OmniProfiler",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:renderer": "vite build",
    "dist": "npm run build:renderer && electron-builder",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "dist:mac": "npm run build:renderer && electron-builder --mac",
    "dist:linux": "npm run build:renderer && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.omniprofiler.desktop",
    "productName": "OmniProfiler",
    "directories": { "output": "release" },
    "files": [
      "electron/**/*",
      "server/**/*",
      "shared/**/*",
      "tools/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": { "category": "public.app-category.developer-tools", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis", "portable"] },
    "linux": { "target": ["AppImage", "deb"], "category": "Development" }
  }
}
