{
  "name": "asset-transformation-service",
  "productName": "Asset Transformation Service",
  "version": "0.2.0",
  "description": "ATS – batch asset optimizer for Unity 6 projects (textures, models, audio) with .meta/GUID safety.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "web:build": "vite build --config vite.web.config.ts",
    "web:serve": "tsx src/server/index.ts",
    "web": "npm run web:build && npm run web:serve",
    "sample": "tsx scripts/make-sample-project.ts",
    "test": "vitest run",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.2.0",
    "@gltf-transform/extensions": "^4.2.0",
    "@gltf-transform/functions": "^4.2.0",
    "better-sqlite3": "^12.4.1",
    "chokidar": "^4.0.3",
    "draco3dgltf": "^1.5.7",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "meshoptimizer": "^0.25.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@rollup/rollup-win32-x64-msvc": "^4.63.5",
    "@tailwindcss/vite": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "three": "^0.180.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.1",
    "wavesurfer.js": "^7.11.0",
    "zustand": "^5.0.8"
  }
}
